#!/sbin/sh
#===============================================================================
# 清荷 - Magisk/KSU 模块安装入口
#===============================================================================

umask 022

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] && . /data/adb/magisk/util_functions.sh
[ -f /data/adb/ksu/util_functions.sh ] && . /data/adb/ksu/util_functions.sh

api_level_arch_detect 2>/dev/null || true

MODPATH=/data/adb/modules/qinghe

ui_print "====================================="
ui_print "  清荷 v2.2.1"
ui_print "  腾讯手游账号本地切换器"
ui_print "====================================="

ui_print "- 解压模块文件..."
mkdir -p $MODPATH 2>/dev/null
unzip -o "$ZIPFILE" -d $MODPATH/ >/dev/null 2>&1
rm -rf $MODPATH/META-INF 2>/dev/null

ui_print "- 设置权限..."
chmod -R 755 $MODPATH 2>/dev/null
chmod 755 $MODPATH/qinghe.sh 2>/dev/null
chmod 755 $MODPATH/lib/*.sh 2>/dev/null

ui_print "- 创建数据目录..."
mkdir -p /data/qinghe 2>/dev/null

ui_print "- 安装全局命令..."
mkdir -p "$MODPATH/system/bin" 2>/dev/null
cat > "$MODPATH/system/bin/qh" << 'QHEOF'
#!/system/bin/sh
exec /data/adb/modules/qinghe/qinghe.sh "$@"
QHEOF
chmod 755 "$MODPATH/system/bin/qh" 2>/dev/null

ui_print ""
ui_print "安装完成!"
ui_print "  qh save <包名>   存号"
ui_print "  qh login <包名>  上号"
ui_print "  qh web [端口]    启动 Web UI"
ui_print "  qh list          查看已保存"
ui_print "  qh               交互菜单"
ui_print "====================================="

exit 0
